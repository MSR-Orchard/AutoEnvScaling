# Copy to .env and fill in what your run needs. Never commit .env.

# Sandbox backend (Modal is the default; run `modal token new` once).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Proposer models, by harness.
ANTHROPIC_API_KEY=        # Claude Code
OPENAI_API_KEY=           # Codex
# Pi routes other models through an OpenAI-compatible endpoint:
AES_PROPOSER_BASE_URL=
AES_PROPOSER_API_KEY=

# Solver endpoint for calibration (OpenAI-compatible, e.g. an SGLang or vLLM server).
AES_SOLVER_BASE_URL=
AES_SOLVER_API_KEY=
AES_SOLVER_MODEL=

# Rubric review (`harbor check`). Defaults to the proposer's own harness and model.
AES_REVIEWER_AGENT=
AES_REVIEWER_MODEL=

# Web search for the proposer (Serper).
SERPER_API_KEY=

# Optional logging.
WANDB_API_KEY=
