+@torch.compile(dynamic=True)
+def compute_binary_divergence(
+    old_log_probs: torch.Tensor,
+    log_probs: torch.Tensor,
+    divergence_type: str,
+) -> torch.Tensor:
+    """Per-token binary (Bernoulli) divergence between the behavior and current policy.
+
+    Collapses the categorical distribution over the vocabulary into a Bernoulli over
+    ``{sampled_token, everything_else}`` using only the per-token log-probs already at
+    hand. This is a memory-cheap lower bound on the true policy divergence that needs no
+    extra forward pass. This is Eqs. 13/14 of the DPPO paper (arXiv:2602.04879).
+
+    Real log-probs are <= 0; the clamp keeps exp() inside (0, 1] even if a padding
+    sentinel leaks through.
+    """
+    mu = torch.exp(old_log_probs.clamp(min=-30.0, max=0.0))
+    pi = torch.exp(log_probs.clamp(min=-30.0, max=0.0))
+    if divergence_type == "tv":
+        return (mu - pi).abs()
+    if divergence_type == "kl":
+        eps = 1e-9
+        mu_c = mu.clamp(eps, 1.0 - eps)
+        pi_c = pi.clamp(eps, 1.0 - eps)
+        return mu_c * (mu_c.log() - pi_c.log()) + (1.0 - mu_c) * ((1.0 - mu_c).log() - (1.0 - pi_c).log())
+    raise ValueError(f"Unknown DPPO divergence type: {divergence_type!r}. Expected 'tv' or 'kl'.")
+
+
+@torch.compile(dynamic=True)
+def compute_dppo_policy_loss(
+    ppo_kl: torch.Tensor,
+    advantages: torch.Tensor,
+    old_log_probs: torch.Tensor,
+    log_probs: torch.Tensor,
+    divergence_type: str,
+    divergence_threshold: float,
+):
+    """DPPO (Divergence PPO) policy loss: a trust region enforced by masking, not clipping.
+
+    The unclipped surrogate ``-ratio * A`` is kept, and a mask zeros only those tokens
+    that would push the policy FURTHER from the rollout (``ratio > 1`` with positive
+    advantage, or ``ratio < 1`` with negative advantage) AND have already left the
+    divergence trust region. Updates that move the ratio back toward 1 are never masked,
+    which preserves PPO's beneficial asymmetry.
+
+    TMax (arXiv:2606.23321) uses DPPO instead of GRPO because GRPO is unstable in
+    long-horizon agentic training (their Fig. 7).
+
+    The masked fraction is returned in place of ``clipfrac`` so existing metric plumbing
+    keeps working; for DPPO the ``pg_clipfrac`` series reads as "fraction of tokens
+    excluded by the trust region".
+    """
+    ratio = _safe_exp_neg_ppo_kl(ppo_kl)
+    pg_losses = -ratio * advantages
+    with torch.no_grad():
+        divergence = compute_binary_divergence(old_log_probs, log_probs, divergence_type)
+        outside_region = divergence > divergence_threshold
+        bad_high = (advantages > 0) & (ratio > 1.0) & outside_region
+        bad_low = (advantages < 0) & (ratio < 1.0) & outside_region
+        keep = (~(bad_high | bad_low)).to(pg_losses.dtype)
+    return pg_losses * keep, 1.0 - keep
+
+
 @torch.compile(dynamic=True)
 def compute_policy_loss(
     ppo_kl: torch.Tensor,
