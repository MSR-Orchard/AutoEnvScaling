+    def _router_detach(self):
+        """Take this engine out of the router's rotation before its memory is released.
+
+        A colocated engine keeps listening while its KV cache and weights are paged out to
+        the CPU. A request that reaches it in that window makes the scheduler run a prefill
+        over CPU tensors and crash ("Pointer argument (at 0) cannot be accessed from
+        Triton"), which ends the run. Agents outside the trainer that still hold the router
+        address (for example proposer sandboxes) can send such requests. Detaching makes the
+        router fail them quickly instead.
+
+        Best effort: a failed detach only restores upstream behaviour, so it warns instead
+        of aborting a training step.
+        """
+        if not self._router_configured():
+            # Loud on purpose: a silent no-op here would look exactly like a working guard.
+            self._guard_note(
+                "NOT detaching before memory release: no router configured "
+                f"(node_rank={self.node_rank} router_ip={self.router_ip!r} "
+                f"router_port={self.router_port!r}); engine stays reachable while paged out"
+            )
+            return
+        worker_url = self._worker_url()
+        try:
+            self._router_remove_worker(context="memory release")
+            self._guard_note(f"detached {worker_url} before memory release")
+        except Exception as e:  # noqa: BLE001 - never fail a train step on the safety detach
+            self._guard_note(f"FAILED to detach {worker_url} ({e}); engine stays reachable")
+
+    def _router_attach(self, attempts: int = 5):
