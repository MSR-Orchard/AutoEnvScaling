+
+        Unlike detach this must not be skipped silently: without the worker the router has
+        nowhere to send rollouts. Retries, then raises.
+        """
+        if not self._router_configured():
+            return
+        base = f"http://{self.router_ip}:{self.router_port}"
+        worker_url = self._worker_url()
+        last: Exception | None = None
+        for attempt in range(attempts):
+            try:
+                if parse(sglang_router.__version__) <= parse("0.2.1") or self.args.use_miles_router:
+                    response = requests.post(f"{base}/add_worker?url={worker_url}", timeout=30)
+                else:
+                    payload = {"url": worker_url, "worker_type": self.worker_type}
+                    response = requests.post(f"{base}/workers", json=payload, timeout=30)
+                response.raise_for_status()
+                self._guard_note(f"re-attached {worker_url} after memory resume")
+                return
+            except Exception as e:  # noqa: BLE001 - retried below
+                last = e
+                self._guard_note(f"re-attach attempt {attempt+1}/{attempts} for {worker_url} failed ({e})")
+                time.sleep(2)
+        raise RuntimeError(f"router: could not re-attach {worker_url} after resume: {last}")
+
